# LLM provider
DAC3D_LLM_PROVIDER=mock
DAC3D_LLM_API_KEY=
DAC3D_LLM_API_BASE_URL=
DAC3D_LLM_MODEL_NAME=claude-3-5-haiku-latest
DAC3D_MAX_GENERATION_TOKENS=700
DAC3D_TEMPERATURE=0.1
DAC3D_TIMEOUT_SECONDS=30
DAC3D_RETRY_COUNT=1
DAC3D_STREAMING=true

# Retrieval
DAC3D_VECTOR_STORE_TYPE=chroma
DAC3D_VECTOR_STORE_COLLECTION=dac3d_iim_documents
DAC3D_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DAC3D_EMBEDDING_DIMENSIONS=384
DAC3D_EMBEDDING_DOWNLOAD_ALLOWED=false
DAC3D_CHUNK_SIZE=180
DAC3D_CHUNK_OVERLAP=40
DAC3D_RETRIEVAL_TOP_K=4
DAC3D_RETRIEVAL_CANDIDATE_K=8
DAC3D_MIN_RETRIEVAL_SCORE=0.16
DAC3D_HISTORY_WINDOW=4
DAC3D_DOCUMENT_GLOBS=**/*.md,**/*.txt,**/*.pdf
DAC3D_LANGUAGE=zh-CN

# DAC-3D integration
DAC3D_MOCK_MODE=true
DAC3D_ENDPOINT=mock://dac3d

# Web UI
DAC3D_GRADIO_HOST=127.0.0.1
DAC3D_GRADIO_PORT=7860
DAC3D_GRADIO_SHARE=false
